# Docker Compose settings. Copy to .env before starting the service.
MONITOR_TOKEN=replace-with-a-long-random-token
MONITOR_BIND_ADDRESS=127.0.0.1
MONITOR_PORT=8787
TZ=Asia/Singapore
PANEL_INCLUDE_TAIL=0
MONITOR_MAX_REQUEST_BODY=16777216
DOCKER_PLATFORM=linux/amd64

# Persistent host directory mounted at /data in the container.
GROK_REGISTER_HOST_DATA_DIR=./data/docker

# Image name used by Compose. Set a registry path when publishing.
GROK_REGISTER_IMAGE=grok-register-panel:local

# Browser and batch recovery controls.
GROK_REGISTER_BROWSER_AUTO_FETCH=1
GROK_BATCH_IDLE_TIMEOUT=360
GROK_BATCH_MAX_RESTARTS=8
PROXY_NETWORK_COOLDOWN_SECONDS=90
PROXY_RISK_COOLDOWN_SECONDS=1800
